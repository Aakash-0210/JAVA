<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         id="WebApp_ID"
         version="5.0">

    <display-name>Servlet_Assginments</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.htm</welcome-file>
        <welcome-file>index.xhtml</welcome-file>
        <welcome-file>default.html</welcome-file>
        <welcome-file>default.jsp</welcome-file>
        <welcome-file>default.htm</welcome-file>
        <welcome-file>default.xhtml</welcome-file>
    </welcome-file-list>

<servlet>
<servlet-name>movieGenra</servlet-name>
<servlet-class>com.servlet.ServletConfigDemo</servlet-class>
 
 <init-param>
 <param-name>defaultGenre</param-name>
 <param-value>Action</param-value>
 </init-param>
</servlet>

<servlet-mapping>
<servlet-name>movieGenra</servlet-name>
<url-pattern>/movieGenra</url-pattern>
</servlet-mapping>


<servlet>
<servlet-name>appTheme</servlet-name>
<servlet-class>com.servlet.ThemeServlet</servlet-class>
</servlet>
 <context-param>
<param-name>defaultTheme</param-name>
<param-value>Dark</param-value>

</context-param> 
<servlet-mapping>
<servlet-name>appTheme</servlet-name>
<url-pattern>/theme</url-pattern>
</servlet-mapping>



<!--  -->
<servlet>
    <servlet-name>ReviewServlet</servlet-name>
    <servlet-class>com.servlet.ReviewServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>ReviewServlet</servlet-name>
    <url-pattern>/addreview</url-pattern>
</servlet-mapping>

    <servlet>
        <servlet-name>aakash</servlet-name>
        <servlet-class>com.servlet.WelcomeUserServlet</servlet-class>

        <init-param>
            <param-name>MyWebApp</param-name>
            <param-value>Instagram</param-value>
        </init-param>
    </servlet>

    <servlet-mapping>
        <servlet-name>aakash</servlet-name>
        <url-pattern>/Home</url-pattern>
    </servlet-mapping>
<error-page>
    <error-code>404</error-code>
    <location>/error404.jsp</location>
</error-page>
</web-app>